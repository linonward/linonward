# DeepSeek Responses API 配置（真实模型通路）
#
# 复制成 .env 后填入真实值；.env 已被仓库根 .gitignore 忽略，不要提交。
#
#   cp .env.example .env
#
# 然后运行真实端到端：
#   pnpm turbo run test:e2e --filter=@linonward/agent-from-scratch-fixture

DEEPSEEK_API_KEY=sk-replace-me

# 可选：默认 https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：默认 deepseek-v4-flash（便宜快）；也可以换成 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash
