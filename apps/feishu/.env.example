# 飞书自建应用凭据，用于建立长连接。不要提交真实凭据。
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace-with-feishu-app-secret

# 仅允许这些飞书 open_id 触发 AI 员工，多个值使用英文逗号分隔。
FEISHU_ALLOWED_OPEN_IDS=ou_replace_with_an_authorized_sender

# 仅需 Actions: write 权限、且仅限当前仓库的 fine-grained GitHub token。
GITHUB_DISPATCH_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=linonward/linonward

# 可选；默认值如下。
# GITHUB_WORKFLOW=ai-employee.yml
# GITHUB_WORKFLOW_REF=main
# GITHUB_API_URL=https://api.github.com
# EXTERNAL_REQUEST_TIMEOUT_MS=30000
# MAX_TASK_LENGTH=6000
