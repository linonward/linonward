{
  "name": "linonward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm format:check",
    "check:branch": "node scripts/check-branch.mjs",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint eslint.config.mjs commitlint.config.mjs scripts --max-warnings=0 && turbo run lint",
    "prepare": "husky",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.4",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix --max-warnings=0",
      "biome format --write"
    ],
    "*.{json,jsonc}": "biome format --write"
  }
}
